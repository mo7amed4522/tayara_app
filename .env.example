FIREBASE_ANDROID_API_KEY=replace_with_android_firebase_api_key
FIREBASE_ANDROID_APP_ID=replace_with_android_firebase_app_id
FIREBASE_IOS_API_KEY=replace_with_ios_firebase_api_key
FIREBASE_IOS_APP_ID=replace_with_ios_firebase_app_id
FIREBASE_IOS_BUNDLE_ID=com.app.taiyara
FIREBASE_MESSAGING_SENDER_ID=replace_with_firebase_messaging_sender_id
FIREBASE_PROJECT_ID=replace_with_firebase_project_id
FIREBASE_STORAGE_BUCKET=replace_with_firebase_storage_bucket
FIREBASE_WEB_API_KEY=replace_with_web_firebase_api_key
FIREBASE_WEB_APP_ID=replace_with_web_firebase_app_id
FIREBASE_WEB_AUTH_DOMAIN=replace_with_firebase_auth_domain
FIREBASE_WEB_MEASUREMENT_ID=replace_with_firebase_measurement_id
GOOGLE_WEB_CLIENT_ID=replace_with_web_oauth_client_id
GOOGLE_IOS_CLIENT_ID=replace_with_ios_oauth_client_id
GOOGLE_REVERSED_CLIENT_ID=replace_with_reversed_ios_oauth_client_id

# --- Kafka transport (support chat bridge, client-side only) ---
# No broker address, SASL credential or TLS material belongs in a mobile bundle.
KAFKA_ENABLED=true
KAFKA_STREAM_BASE_URL=
KAFKA_API_VERSION=v1
KAFKA_CHAT_MESSAGES_TOPIC=tayara.support.chat.messages.v1
KAFKA_CHAT_EVENTS_TOPIC=tayara.support.chat.events.v1
KAFKA_PRESENCE_TOPIC=tayara.support.presence.v1
KAFKA_CHAT_MESSAGES_DLQ_TOPIC=tayara.support.chat.messages.dlq.v1
KAFKA_HEARTBEAT_TIMEOUT_SECONDS=45
KAFKA_MAX_RECONNECT_ATTEMPTS=8
